OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:latest
EMBEDDING_MODEL=nomic-embed-text
DB_PATH=db/compliance.db
VECTORSTORE_DIR=vectorstore
BANK_POLICIES_DIR=data/bank_policies

# Scheduled Airflow Polling (Hours)
POLLING_INTERVAL_HOURS=6

# Milvus Distributed Vector Database Settings
MILVUS_HOST=localhost
MILVUS_PORT=19530
VECTOR_ENGINE=milvus

# Multi-Channel Alerting (slack | email | all | none)
ALERT_CHANNEL=none
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENTS=officer@bankofindia.co.in,audit@bankofindia.co.in
